# ----------------------------------------------------------------------
# Configuração Apache / LiteSpeed para cPanel (levichiavelli.dev.br)
# ----------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html
DirectorySlash On

# Página de erro 404 personalizada
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forçar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Forçar apex domain (remover www)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 3. Redirecionamento de idioma por query string (?lang=) para rota limpa
  RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$) [NC]
  RewriteRule ^$ /en [R=301,L,QSD]

  RewriteCond %{QUERY_STRING} (?:^|&)lang=pt(?:&|$) [NC]
  RewriteRule ^$ / [R=301,L,QSD]

  RewriteCond %{QUERY_STRING} (?:^|&)lang=pt(?:&|$) [NC]
  RewriteRule ^en/?$ / [R=301,L,QSD]

  # 4. URLs limpas para diretórios estáticos (/en, /hamburgueria, /hamburgueria/painel)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ /$1/index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Cabeçalhos de Cache (mod_headers)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Assets com hash estático (Astro e Next.js) e mídias cacheados por 1 ano
  <FilesMatch "\.(js|css|webp|png|jpe?g|gif|svg|ico|woff2?|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Arquivos HTML e manifestos sempre revalidados para refletir deploys imediatamente
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Segurança
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------------
# Compressão Gzip / Deflate (mod_deflate)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
