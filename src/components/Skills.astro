---
import { content } from '../data/site';
import T from './T.astro';
---

<section id="habilidades" class="border-b border-line/60 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal max-w-2xl" data-reveal>
      <p class="kicker"><T value={content.skills.kicker} /></p>
      <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        <T value={content.skills.heading} />
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted">
        <T value={content.skills.intro} />
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {content.skills.groups.map((group, index) => (
        <div
          class="card card-lift reveal"
          data-reveal
          style={`--reveal-delay: ${index * 70}ms`}
        >
          <h3 class="text-sm font-semibold text-ink">
            <T value={group.title} />
          </h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
