---
import { content } from '../data/site';
import T from './T.astro';
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="#top" class="flex items-center gap-3 text-sm font-semibold tracking-tight">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-line bg-surface text-base font-bold text-accent"
        aria-hidden="true">L</span
      >
      <span>Levi Chiavelli</span>
    </a>

    <nav class="hidden items-center gap-6 text-sm text-muted md:flex" aria-label="Navegação principal / Main navigation">
      <a class="transition-colors hover:text-ink" href="#sobre"><T value={content.nav.about} /></a>
      <a class="transition-colors hover:text-ink" href="#habilidades"><T value={content.nav.skills} /></a>
      <a class="transition-colors hover:text-ink" href="#projetos"><T value={content.nav.projects} /></a>
      <a class="transition-colors hover:text-ink" href="#contato"><T value={content.nav.contact} /></a>
    </nav>

    <div
      class="flex items-center gap-1 rounded-lg border border-line bg-surface p-1"
      role="group"
      aria-label="Idioma / Language">
      <button type="button" class="lang-btn" data-lang-btn="pt" aria-pressed="true" lang="pt">PT</button>
      <button type="button" class="lang-btn" data-lang-btn="en" aria-pressed="false" lang="en">EN</button>
    </div>
  </div>
</header>
