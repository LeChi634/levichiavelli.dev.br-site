---
import { content } from '../data/site';
import T from './T.astro';

const snippet = `const dev = {
  name: "Levi Chiavelli",
  studying: "Systems Development",
  stack: ["HTML", "CSS", "JS"],
  focus: "front-end & back-end",
};`;
---

<section id="top" class="relative overflow-hidden border-b border-line/60">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(65%_55%_at_50%_0%,rgba(52,211,153,0.14),transparent_70%)]"
    aria-hidden="true">
  </div>

  <div
    class="relative mx-auto grid max-w-6xl gap-14 px-5 pb-20 pt-20 sm:px-8 sm:pt-28 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:pb-28">
    <div>
      <p class="flex items-center gap-2 kicker">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        <T value={content.hero.eyebrow} />
      </p>

      <h1 class="mt-6 text-5xl font-bold tracking-tight sm:text-6xl">
        Levi Chiavelli<span class="text-accent">.</span>
      </h1>

      <p class="mt-4 text-lg font-medium text-ink/90 sm:text-xl">
        <T value={content.hero.role} />
      </p>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-muted">
        <T value={content.hero.tagline} />
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="#projetos" class="btn-primary">
          <T value={content.hero.ctaProjects} />
          <span aria-hidden="true">↓</span>
        </a>
        <a href="#contato" class="btn-ghost">
          <T value={content.hero.ctaContact} />
        </a>
      </div>
    </div>

    <div class="hidden lg:block" aria-hidden="true">
      <div class="card font-mono text-xs leading-6 text-muted shadow-2xl shadow-black/40">
        <div class="mb-4 flex gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-accent/70"></span>
        </div>
        <p class="text-[11px] text-accent/80"><T value={content.hero.codeLabel} /></p>
        <pre class="mt-2 whitespace-pre-wrap text-ink/80"><code>{snippet}</code></pre>
      </div>
    </div>
  </div>
</section>
