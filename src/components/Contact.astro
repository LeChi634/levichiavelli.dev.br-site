---
import { contact, content, site } from '../data/site';
import T from './T.astro';
---

<section id="contato" class="py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="card reveal relative overflow-hidden p-8 sm:p-12" data-reveal>
      <div
        class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-accent/10 blur-3xl"
        aria-hidden="true">
      </div>

      <div class="relative max-w-2xl">
        <p class="kicker"><T value={content.contact.kicker} /></p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
          <T value={content.contact.heading} />
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted">
          <T value={content.contact.intro} />
        </p>
      </div>

      <div class="relative mt-10 grid gap-3 sm:grid-cols-3">
        <a class="contact-card" href={contact.emailHref}>
          <span class="contact-card-label block text-xs"
            ><T value={content.contact.emailLabel} /></span
          >
          <span class="contact-card-value mt-1 block break-all text-sm font-medium text-ink"
            >{contact.email}</span
          >
        </a>

        <a
          class="contact-card"
          href={site.github}
          target="_blank"
          rel="noopener noreferrer">
          <span class="contact-card-label block text-xs"
            ><T value={content.contact.githubLabel} /></span
          >
          <span class="contact-card-value mt-1 block text-sm font-medium text-ink"
            >github.com/LeChi634</span
          >
        </a>

        <a
          class="contact-card"
          href={contact.linkedinHref}
          target="_blank"
          rel="noopener noreferrer">
          <span class="contact-card-label block text-xs"
            ><T value={content.contact.linkedinLabel} /></span
          >
          <span class="contact-card-value mt-1 block break-all text-sm font-medium text-ink"
            >{contact.linkedin}</span
          >
        </a>
      </div>

      <div class="relative mt-8">
        <a class="btn btn-primary" href={contact.emailHref}>
          <T value={content.contact.cta} />
          <span class="btn-arrow btn-arrow--diag" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
